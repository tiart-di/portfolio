{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/iask-search",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/iask-search.html",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/iask-ios",
      "destination": "/ios",
      "permanent": true
    },
    {
      "source": "/iask-ios.html",
      "destination": "/ios",
      "permanent": true
    },
    {
      "source": "/seo-article-generator",
      "destination": "/seo",
      "permanent": true
    },
    {
      "source": "/seo-article-generator.html",
      "destination": "/seo",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles\\.css|script\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}